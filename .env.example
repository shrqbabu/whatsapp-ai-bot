# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Database Configuration
# For local development with zero dependencies, SQLite is used automatically:
SQLITE_PATH=data/app.db
# For production PostgreSQL / Supabase, uncomment and set:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_ai_db

# Storage Directory for Isolated WhatsApp Multi-Device Sessions
SESSION_STORAGE_DIR=storage/sessions

# AI Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_SYSTEM_PROMPT="You are a helpful and professional customer support assistant. Reply politely and concisely. Use the same language as the customer."

# Tuning Parameters
MAX_HISTORY_MESSAGES=10
