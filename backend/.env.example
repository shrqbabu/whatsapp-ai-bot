# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Database Configuration
SQLITE_PATH=data/app.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_ai_db

# Storage Directory for Isolated WhatsApp Sessions
SESSION_STORAGE_DIR=storage/sessions

# ==============================================================================
# OpenAI-Compatible AI Provider Configuration (Supports Third-Party Gateways)
# ==============================================================================
# Works with:
# 1. Official OpenAI:
#    OPENAI_BASE_URL=https://api.openai.com/v1
#    OPENAI_API_KEY=sk-proj-xxxxxx
#    DEFAULT_AI_MODEL=gpt-4o-mini
#
# 2. OpenRouter (Access 200+ models: Claude, Llama 3, DeepSeek, Gemini, etc.):
#    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#    OPENAI_API_KEY=sk-or-v1-xxxxxx
#    DEFAULT_AI_MODEL=meta-llama/llama-3.3-70b-instruct
#
# 3. Groq (Ultra-fast inference):
#    OPENAI_BASE_URL=https://api.groq.com/openai/v1
#    OPENAI_API_KEY=gsk_xxxxxx
#    DEFAULT_AI_MODEL=llama-3.3-70b-versatile
#
# 4. DeepSeek:
#    OPENAI_BASE_URL=https://api.deepseek.com/v1
#    OPENAI_API_KEY=sk-xxxxxx
#    DEFAULT_AI_MODEL=deepseek-chat
#
# 5. Together AI:
#    OPENAI_BASE_URL=https://api.together.xyz/v1
#    OPENAI_API_KEY=xxxxxx
#    DEFAULT_AI_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#
# 6. Local LLM / Ollama:
#    OPENAI_BASE_URL=http://localhost:11434/v1
#    OPENAI_API_KEY=ollama
#    DEFAULT_AI_MODEL=llama3.2
# ==============================================================================

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_SYSTEM_PROMPT="You are a friendly customer support assistant. Reply naturally and concisely. Use Hindi/Hinglish when the customer uses Hindi. Do not invent prices, policies or information."

# Tuning Parameters
MAX_HISTORY_MESSAGES=10
